    "typecheck": "node infrastructure/scripts/astro-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.9.0",
    "typescript-eslint": "8.66.0"
  }
}
