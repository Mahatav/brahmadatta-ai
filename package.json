{
  "name": "brahmadatta-ai-tooling",
  "private": true,
  "version": "0.0.0",
  "description": "Repository-root JavaScript/TypeScript tooling. Application dependencies live in apps/command-center/package.json, which this file deliberately does not own.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern",
