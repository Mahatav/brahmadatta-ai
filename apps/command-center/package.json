{
  "name": "@brahmadatta/command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "generate:api": "openapi-typescript ../../packages/schemas/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "node scripts/check-generated-api-types.mjs",
    "check:issue-20": "node scripts/check-issue-20-analysis-rail.mjs",
    "check:local-intake": "node scripts/check-local-repository-intake.mjs",
    "check:security": "node scripts/check-render-safety.mjs",
    "check:mission-control-client": "node --experimental-strip-types scripts/check-mission-control-client.mjs",
    "check:mission-control-form": "node --experimental-strip-types scripts/check-mission-control-form.mjs",
    "check:brahmadatta-core": "node scripts/check-brahmadatta-core.mjs",
    "check:stage-timeline": "node scripts/check-stage-timeline.mjs",
    "check:findings-evidence": "node scripts/check-findings-evidence.mjs",
    "check:candidate-compare": "node scripts/check-candidate-compare-overlay.mjs",
    "check:bottom-strip": "node scripts/check-bottom-strip-ledger.mjs",
    "check:mission-snapshot-hydration": "node --experimental-strip-types scripts/check-mission-snapshot-hydration.mjs",
    "check:presentation-mode": "node --experimental-strip-types scripts/check-presentation-mode.mjs",
    "check:issue-56-keyboard": "node scripts/check-issue-56-keyboard-operability.mjs",
    "check:issue-31": "node scripts/check-issue-31-fuzzing-report.mjs",
    "check:issue-25-analysis-rail-findings": "node --experimental-strip-types scripts/check-issue-25-analysis-rail-findings.mjs",
    "check:git-history-bisect": "node --experimental-strip-types scripts/check-git-history-bisect-panel.mjs",
    "check": "npm run check:security && npm run check:issue-20 && npm run check:local-intake && npm run check:api && npm run check:mission-control-client && npm run check:mission-control-form && npm run check:brahmadatta-core && npm run check:stage-timeline && npm run check:findings-evidence && npm run check:candidate-compare && npm run check:bottom-strip && npm run check:mission-snapshot-hydration && npm run check:presentation-mode && npm run check:issue-56-keyboard && npm run check:issue-31 && npm run check:issue-25-analysis-rail-findings && npm run check:git-history-bisect && ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "build": "npm run check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "smoke:local": "node scripts/smoke-local-command-center.mjs",
    "dev:presentation": "ASTRO_TELEMETRY_DISABLED=1 BD_PRESENTATION_BUILD=true astro dev",
    "build:presentation": "ASTRO_TELEMETRY_DISABLED=1 BD_PRESENTATION_BUILD=true astro build --outDir dist-presentation",
    "preview:presentation": "ASTRO_TELEMETRY_DISABLED=1 BD_PRESENTATION_BUILD=true astro preview --outDir dist-presentation",
    "check:presentation-build-exclusion": "bash scripts/check-presentation-build-exclusion.sh",
    "dev:keyboard-harness": "ASTRO_TELEMETRY_DISABLED=1 BD_KEYBOARD_HARNESS_BUILD=true astro dev --port 4322",
    "build:keyboard-harness": "ASTRO_TELEMETRY_DISABLED=1 BD_KEYBOARD_HARNESS_BUILD=true astro build --outDir dist-keyboard-harness",
    "preview:keyboard-harness": "ASTRO_TELEMETRY_DISABLED=1 BD_KEYBOARD_HARNESS_BUILD=true astro preview --outDir dist-keyboard-harness --port 4322",
    "check:keyboard-harness-exclusion": "bash scripts/check-keyboard-harness-exclusion.sh",
    "verify:keyboard-operability": "node scripts/verify-keyboard-operability.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource/fragment-mono": "5.2.6",
    "@fontsource/instrument-serif": "5.2.6",
    "@fontsource/rajdhani": "5.2.6",
    "@fontsource/rozha-one": "5.2.6",
    "@nanostores/react": "1.0.0",
    "astro": "^7.2.2",
    "nanostores": "1.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "openapi-typescript": "7.9.1",
    "playwright": "1.62.1",
    "typescript": "5.9.2"
  }
}
