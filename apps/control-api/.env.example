# Brahmadatta AI — control API environment
#
# Copy to apps/control-api/.env and fill in. `.env` is gitignored; never commit one.
# Every value here is a placeholder. Generate real secrets locally:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Profile ------------------------------------------------------------------
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
LOG_LEVEL=INFO

# --- Django core --------------------------------------------------------------
# Required. Startup fails without it rather than falling back to a known key.
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_GENERATED_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:8080

# Django admin: useful in development for inspecting evidence records, and closed
# for the finale. config.settings.finale forces this off regardless of the value here.
CONTROL_API_ADMIN_ENABLED=true

# --- Database -----------------------------------------------------------------
# PostgreSQL. SQLite is accepted for local test runs only, in these spellings:
#
#   sqlite://                    in-memory
#   sqlite:///:memory:           in-memory
#   sqlite:///local.sqlite3      relative to the working directory
#   sqlite:////var/tmp/x.sqlite3 absolute
#
# TLS query parameters ARE forwarded to libpq: sslmode, sslrootcert, sslcert, sslkey,
# sslcrl. Any OTHER query parameter refuses to boot rather than being dropped silently
# (SEC-18) — a discarded connection setting is one the operator believes is in effect.
#
# libpq's own default is `sslmode=prefer`, which attempts TLS and then falls back to
# PLAINTEXT WITHOUT ERROR if the server declines, validating no certificate either way.
# So state it. APP_ENV=finale refuses to start on anything weaker than `require`:
#
#   ...?sslmode=verify-full&sslrootcert=/etc/ssl/certs/postgres-ca.pem   preferred
#   ...?sslmode=require                                                  minimum
DATABASE_URL=postgresql://brahmadatta:REPLACE_ME@localhost:5432/brahmadatta

# --- Operator authentication ---------------------------------------------------
# One bearer token per role. An unset token means that role cannot authenticate at
# all — the API fails closed. Minimum 32 characters.
CONTROL_API_OPERATOR_TOKEN=REPLACE_ME_OPERATOR_TOKEN_MIN_32_CHARS
CONTROL_API_REVIEWER_TOKEN=
CONTROL_API_ADMIN_TOKEN=

# --- Model routing --------------------------------------------------------------
# HARD RULE: repository content never reaches a hosted third-party inference API.
# These are validated at startup (contracts.checks.check_model_endpoints) and must be
# loopback, private-range, or explicitly declared in MODEL_SERVICE_NAMES. A hosted
# provider host fails `manage.py check`.
SMALL_MODEL_BASE_URL=
MODEL_SERVICE_NAMES=
# Tier 3 / rented GPU is CUT (D-015). Leave blank.
TIER3_BASE_URL=

# --- Model gateway (services/model-gateway, #168 T4-lite) ------------------------
# Where a patch candidate comes from. NO DEFAULT — an unset value is a startup error
# in the worker process. `live` calls the self-hosted model; `replay` serves a
# recorded transcript (#82). Read directly by JobKind.PATCH_GENERATE's executor
# (orchestrator/patch_generate_executor.py), never by the ASGI process.
MODEL_GATEWAY_MODE=live
# The gateway's own endpoint variable. Blank falls back to SMALL_MODEL_BASE_URL
# above — see the root .env.example for the full note on why the two names exist.
MODEL_ENDPOINT=
MODEL_TRANSCRIPT_ROOT=../../services/model-gateway/transcripts
MODEL_ALLOW_SYNTHETIC_TRANSCRIPTS=false

# Mission-scoped local model host lifecycle (#36). Leave disabled unless the control
# process can run Docker/Compose on the host. When enabled, entering PATCH starts the
# compose `model-host` service and mission teardown stops it.
MODEL_HOST_LIFECYCLE_ENABLED=false
MODEL_HOST_RUNTIME=docker
MODEL_HOST_COMPOSE_FILE=infrastructure/compose/docker-compose.yml
MODEL_HOST_COMPOSE_PROFILE=model
MODEL_HOST_COMPOSE_SERVICE=model-host
MODEL_HOST_RESOURCE_ID=model-host
MODEL_HOST_LEASE_SECONDS=1800
MODEL_HOST_COMMAND_TIMEOUT_SECONDS=60

# D-075 / SEC-50: MODEL_HOST_BEARER_TOKEN is DELIBERATELY NOT DECLARED HERE.
# infrastructure/scripts/run-fuzz-worker.sh (D-073's bare-metal fuzz-worker process)
# sources THIS FILE wholesale (`set -a; source apps/control-api/.env; set +a`) when it
# needs DATABASE_URL — a var declared here would land in fuzz-worker's process
# environment even though fuzz-worker's code never reads it and has no model-gateway
# client at all (tests/architecture/test_fuzz_worker_isolation.py). Ambient exposure
# through an unrelated `source` is exactly the shape of leak the bearer-token fix
# exists to close; do not "helpfully" add MODEL_HOST_BEARER_TOKEN to this file without
# re-reading the reasoning in .project/decisions.md's D-075. It lives only in the
# repository-root .env.example (compose-only), which this script never sources.

# --- Orchestrator / worker (#168, T0) --------------------------------------------
# manage.py run_orchestrator (tick loop) and manage.py run_worker (claim loop). All
# four have working defaults; set only to tune. See orchestrator/queue.py.
ORCHESTRATOR_TICK_INTERVAL_SECONDS=1.0
WORKER_JOB_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_POLL_INTERVAL_SECONDS=1.0

# D-073: `manage.py run_worker` also takes a `--kinds` CLI flag (not an env var —
# there is nothing to set here). Omitted: claims every JobKind except FUZZ/MINIMIZE.
# `--kinds FUZZ,MINIMIZE`: claims ONLY those two, and is how `fuzz-worker`
# (infrastructure/scripts/run-fuzz-worker.sh) runs, bare-metal, never in this
# container. See missions/management/commands/run_worker.py's module docstring.

# --- Sandbox policy -------------------------------------------------------------
# SANDBOX_NETWORK is deny and the API has no vocabulary for anything else.
# SANDBOX_RUNTIME defaults to docker (D-036, not D-024 — see the numbering note on
# D-073 in .project/decisions.md: a standard rootful-daemon container with
# --network none, accepted as the substitute for rootless Podman — see
# docs/09-company/08-security-review.md §6 and packages/sandbox/container.py).
SANDBOX_RUNTIME=docker
SANDBOX_NETWORK=deny
SANDBOX_CPU_LIMIT=4
SANDBOX_MEMORY_MB=8192
SANDBOX_MAX_SECONDS=5400

# --- Server-sent events (#13) ---------------------------------------------------
# All three have working defaults (4 / 0.5s / 15s); set only to tune for a demo or a
# test. See config/settings/base.py for the full reasoning.
SSE_MAX_STREAMS_PER_MISSION=
SSE_POLL_INTERVAL_SECONDS=
SSE_HEARTBEAT_INTERVAL_SECONDS=

# --- Snapshot ingestion (#18) -----------------------------------------------------
# Content-addressed artifact store. Defaults to a directory under the app; point this
# at the host's encrypted volume in a real deployment.
ARTIFACT_ROOT=
# Local directories a mission's own repository_ref may resolve inside, when a
# snapshot is built directly from the repository rather than from an uploaded
# archive. A repository_ref outside this root is refused, never read.
SNAPSHOT_SOURCE_ROOT=
# Where an uploaded archive is expected to be staged before POST .../snapshot names
# it via archive_ref.
SNAPSHOT_STAGING_ROOT=
# Byte ceiling for one snapshot archive. Ingestion refuses, rather than truncates,
# the instant this is crossed.
SNAPSHOT_MAX_BYTES=536870912
# Where a mission's stored snapshot archive is extracted back to disk for a stage to
# build/test against (orchestrator.snapshot.materialize_snapshot, #168 T0b). A fresh
# directory per call; never reused across missions or stage runs.
SNAPSHOT_WORKSPACE_ROOT=
