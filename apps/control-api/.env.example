# Brahmadatta AI — control API environment
#
# Copy to apps/control-api/.env and fill in. `.env` is gitignored; never commit one.
# Every value here is a placeholder. Generate real secrets locally:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Profile ------------------------------------------------------------------
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
LOG_LEVEL=INFO

# --- Django core --------------------------------------------------------------
# Required. Startup fails without it rather than falling back to a known key.
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_GENERATED_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:8080

# Django admin: useful in development for inspecting evidence records, and closed
# for the finale. config.settings.finale forces this off regardless of the value here.
CONTROL_API_ADMIN_ENABLED=true

# --- Database -----------------------------------------------------------------
# PostgreSQL. SQLite is accepted for local test runs only, in these spellings:
#
#   sqlite://                    in-memory
#   sqlite:///:memory:           in-memory
#   sqlite:///local.sqlite3      relative to the working directory
#   sqlite:////var/tmp/x.sqlite3 absolute
#
# TLS query parameters ARE forwarded to libpq: sslmode, sslrootcert, sslcert, sslkey,
# sslcrl. Any OTHER query parameter refuses to boot rather than being dropped silently
# (SEC-18) — a discarded connection setting is one the operator believes is in effect.
#
# libpq's own default is `sslmode=prefer`, which attempts TLS and then falls back to
# PLAINTEXT WITHOUT ERROR if the server declines, validating no certificate either way.
# So state it. APP_ENV=finale refuses to start on anything weaker than `require`:
#
#   ...?sslmode=verify-full&sslrootcert=/etc/ssl/certs/postgres-ca.pem   preferred
#   ...?sslmode=require                                                  minimum
DATABASE_URL=postgresql://brahmadatta:REPLACE_ME@localhost:5432/brahmadatta

# --- Operator authentication ---------------------------------------------------
# One bearer token per role. An unset token means that role cannot authenticate at
# all — the API fails closed. Minimum 32 characters.
CONTROL_API_OPERATOR_TOKEN=REPLACE_ME_OPERATOR_TOKEN_MIN_32_CHARS
CONTROL_API_REVIEWER_TOKEN=
CONTROL_API_ADMIN_TOKEN=

# --- Model routing --------------------------------------------------------------
# HARD RULE: repository content never reaches a hosted third-party inference API.
# These are validated at startup (contracts.checks.check_model_endpoints) and must be
# loopback, private-range, or *.internal. A hosted provider host fails `manage.py check`.
# Leave blank until the local model host exists (issue #25).
SMALL_MODEL_BASE_URL=
MODEL_SERVICE_NAMES=
# Tier 3 / rented GPU is CUT (D-015). Leave blank.
TIER3_BASE_URL=

# --- Sandbox policy -------------------------------------------------------------
# SANDBOX_NETWORK is deny and the API has no vocabulary for anything else.
# SANDBOX_RUNTIME defaults to docker (D-024: a standard rootful-daemon container with
# --network none, accepted as the substitute for rootless Podman — see
# docs/09-company/08-security-review.md §6 and packages/sandbox/container.py).
SANDBOX_RUNTIME=docker
SANDBOX_NETWORK=deny
SANDBOX_CPU_LIMIT=4
SANDBOX_MEMORY_MB=8192
SANDBOX_MAX_SECONDS=5400

# --- Server-sent events (#13) ---------------------------------------------------
# All three have working defaults (4 / 0.5s / 15s); set only to tune for a demo or a
# test. See config/settings/base.py for the full reasoning.
SSE_MAX_STREAMS_PER_MISSION=
SSE_POLL_INTERVAL_SECONDS=
SSE_HEARTBEAT_INTERVAL_SECONDS=

# --- Snapshot ingestion (#18) -----------------------------------------------------
# Content-addressed artifact store. Defaults to a directory under the app; point this
# at the host's encrypted volume in a real deployment.
ARTIFACT_ROOT=
# Local directories a mission's own repository_ref may resolve inside, when a
# snapshot is built directly from the repository rather than from an uploaded
# archive. A repository_ref outside this root is refused, never read.
SNAPSHOT_SOURCE_ROOT=
# Where an uploaded archive is expected to be staged before POST .../snapshot names
# it via archive_ref.
SNAPSHOT_STAGING_ROOT=
# Byte ceiling for one snapshot archive. Ingestion refuses, rather than truncates,
# the instant this is crossed.
SNAPSHOT_MAX_BYTES=536870912
