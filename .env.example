# Brahmadatta AI — environment for the DEVELOPMENT compose stack.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way. NOTHING IN THIS FILE IS A REAL CREDENTIAL,
# and nothing that is one may ever be committed. Generate real values locally:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Scope of this file: the compose stack (infrastructure/compose/docker-compose.yml). It is
# read two ways — by Compose for ${VAR} interpolation, and by each container through
# `env_file`. Where a key also appears in apps/control-api/.env.example, THAT file is the
# authority on what the key means; the value here is the containerised equivalent
# (service hostnames instead of localhost, the nginx origin instead of the Astro port).
#
# Injection mechanism, by environment:
#   development — this file, copied to .env, never committed
#   CI          — no .env at all. The workflow sets only what a test needs, inline. No
#                 repository or environment secret is required for any current job.
#   finale      — .env written on the box by hand from a password manager, mode 0600,
#                 owned by the operator account. Not generated, not copied from a laptop,
#                 not stored in the repository. See
#                 docs/06-operations/71-ingress-and-proxy-contract.md.

# --- Profile -------------------------------------------------------------------
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
LOG_LEVEL=INFO

# --- Django core ---------------------------------------------------------------
# Required. The API fails to start rather than falling back to a known key.
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_GENERATED_SECRET
DJANGO_DEBUG=true

# `nginx` and `control-api` are compose service names; requests arrive from the proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-api,nginx

# The browser origin is the nginx TLS listener, NOT the Astro dev port — everything is
# reached through the proxy in this stack. Both schemes are listed because 8080 redirects.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,http://localhost:8080

# Django admin. Reachable in development from private networks only (the proxy allow-list
# in infrastructure/compose/nginx/profile/admin-allow.conf). The finale profile forces
# this false AND returns 404 at the proxy.
CONTROL_API_ADMIN_ENABLED=true

# --- Database ------------------------------------------------------------------
# Consumed by Compose to initialise the postgres container.
POSTGRES_DB=brahmadatta
POSTGRES_USER=brahmadatta
POSTGRES_PASSWORD=REPLACE_ME_LOCAL_DEV_PASSWORD

# Consumed by Django. Host is the compose service name, not localhost.
DATABASE_URL=postgresql://brahmadatta:REPLACE_ME_LOCAL_DEV_PASSWORD@db:5432/brahmadatta

# D-073: the dev profile's `db` also publishes on LOOPBACK ONLY (127.0.0.1), so that
# `fuzz-worker` — a bare-metal host process, infrastructure/scripts/run-fuzz-worker.sh,
# NOT a compose service — can reach Postgres from outside the compose network at all.
# Not published in the finale profile; see the D-073 follow-up entry in
# .project/decisions.md for that open question. Override the host-side port here if
# 5432 is already taken on your machine; the container's own port is unaffected.
POSTGRES_PORT=5432

# --- Queue ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Finale only; the dev redis has no password and no published port.
REDIS_PASSWORD=

# The worker service is opt-in (`--profile worker`; DEV_UP_WORKER=1 for dev-up.sh).
#
# D-062/D-122: the queue framework question D-018 left open resolved to "one table, no
# broker" (architecture spec §3.1, `orchestrator/queue.py`) — `manage.py run_worker` is
# the real command, not `rqworker` (no `django_rq` dependency exists in this project at
# all). The literal `rqworker` default below was stale from before that resolution and
# crash-looped every fresh `worker` container on `Unknown command: 'rqworker'` until
# fixed here — found live, #50 D7 gate rehearsal run 4 (D-098), worked around only in an
# untracked local `.env` until this fix.
#
# D-073: this command/service is the general worker fleet, which excludes FUZZ/MINIMIZE
# BY DESIGN (no docker CLI in this container, D-036 forbids mounting the socket). FUZZ/
# MINIMIZE run on a separate, bare-metal `fuzz-worker` process — see
# infrastructure/scripts/run-fuzz-worker.sh — not on this service, regardless of what
# this command line says. Do not point CONTROL_API_WORKER_CMD at `--kinds FUZZ` here.
CONTROL_API_WORKER_CMD=python manage.py run_worker

# --- Operator authentication ----------------------------------------------------
# One bearer token per role. An unset token means that role cannot authenticate at all;
# the API fails closed. Minimum 32 characters. See apps/control-api/.env.example.
CONTROL_API_OPERATOR_TOKEN=REPLACE_ME_OPERATOR_TOKEN_MIN_32_CHARS
CONTROL_API_REVIEWER_TOKEN=
CONTROL_API_ADMIN_TOKEN=

# --- Frontend -------------------------------------------------------------------
# What the BROWSER should call, i.e. through nginx. Never a compose service name: the
# browser cannot resolve `control-api`.
PUBLIC_API_BASE_URL=https://localhost:8443

# --- Model routing ---------------------------------------------------------------
# HARD RULE, from CLAUDE.md and docs/03-technical/23-security-plan.md: repository content
# never reaches a hosted third-party inference API. These must be loopback, private-range,
# or a name you have declared in MODEL_SERVICE_NAMES below; the endpoint policy validates
# them at startup and refuses a hosted provider host.
# Blank until the local model host exists (issue #25).
SMALL_MODEL_BASE_URL=
# Tier 3 / rented GPU is CUT (D-015). Leave blank.
TIER3_BASE_URL=

# Hostnames you are declaring as the local model host. Comma-separated, EMPTY BY DEFAULT.
#
# Read this before you debug a refusal. Loopback (127.0.0.1, ::1, localhost), the RFC 1918
# ranges and IPv6 unique-local work with no declaration at all, so an ordinary laptop setup
# needs nothing here. A *name* does need declaring — including a compose service name like
# `small-model`, and including anything ending .internal, .local, .svc or .test.
#
# Those four suffixes used to pass on the suffix alone. They no longer do (D-051), because
# nobody owns those namespaces: `evil.internal` and `api.openai.com.evil.test` both passed
# the old check. Declaration grants trust, not the suffix.
#
# So if `http://small-model:8080/v1` or `http://model-host.internal:8080/v1` is refused at
# startup, this is the line to add it to — that refusal is the rule working, not a bug.
MODEL_SERVICE_NAMES=

# --- Model gateway (services/model-gateway) ----------------------------------------
# Where a patch candidate comes from. NO DEFAULT — an unset value is a startup error.
# `live` calls the self-hosted model; `replay` serves a recorded transcript (#82). The
# choice is a claim about the system's own output, so it is never made by silence (D-049).
MODEL_GATEWAY_MODE=live
# The gateway's own endpoint variable (services/model-gateway/gateway/settings.py),
# read directly by #168 T4's JobKind.PATCH_GENERATE executor. Blank here falls back to
# SMALL_MODEL_BASE_URL above, so most deployments do not need to set both — this exists
# because services/model-gateway is a standalone checkout with its own settings module
# (D-052) that was never wired to the control API's own naming until T4. Flagged for
# ml-infra-engineer to reconcile into one name; not decided unilaterally here.
MODEL_ENDPOINT=
# Where recorded transcripts live. Captured automatically on the live path.
MODEL_TRANSCRIPT_ROOT=services/model-gateway/transcripts
# Serve transcripts written by hand rather than captured from a model run. Tests only —
# a hand-written transcript is not model output and must not be labelled as any.
MODEL_ALLOW_SYNTHETIC_TRANSCRIPTS=false

# Mission-scoped local model host lifecycle (#36). Leave disabled unless the control
# process can run Docker/Compose on the host. When enabled, entering PATCH starts the
# compose `model-host` service and mission teardown stops it.
MODEL_HOST_LIFECYCLE_ENABLED=false
MODEL_HOST_RUNTIME=docker
MODEL_HOST_COMPOSE_FILE=infrastructure/compose/docker-compose.yml
MODEL_HOST_COMPOSE_PROFILE=model
MODEL_HOST_COMPOSE_SERVICE=model-host
MODEL_HOST_RESOURCE_ID=model-host
MODEL_HOST_LEASE_SECONDS=1800
MODEL_HOST_COMMAND_TIMEOUT_SECONDS=60

# D-075 / SEC-50. The `model-host` service (above) binds Ollama to loopback ONLY
# inside its own container/network namespace; the `model-host-auth` nginx sidecar
# shares that exact namespace (`network_mode: "service:model-host"`) and is the only
# thing that can still reach it. Every other container on `backend` — including one a
# Docker-daemon-holding adversary joins directly, which is what SEC-50 demonstrated —
# now hits a listener that demands this token and has no way to obtain it.
#
# Blank here, on purpose, the same "unset = that credential cannot authenticate at
# all, fails closed" convention CONTROL_API_REVIEWER_TOKEN/CONTROL_API_ADMIN_TOKEN
# already use above — NOT the same convention REDIS_PASSWORD's blank default uses,
# which disables redis's own auth mechanism outright. There is no such bypass in
# model-host-auth's nginx conf: leaving this blank means `--profile model` is up but
# unusable (every request gets 401) until you generate a real value, the same way you
# would for CONTROL_API_OPERATOR_TOKEN:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# docker-compose.finale.yml requires this (`:?`) — the finale stack refuses to start
# `--profile model` at all without a real value set.
#
# Deliberately declared ONLY here (the compose-only .env), never in
# apps/control-api/.env.example: `infrastructure/scripts/run-fuzz-worker.sh` sources
# apps/control-api/.env wholesale (`set -a; source .env; set +a`) for the bare-metal
# `fuzz-worker` process (D-073) — a var declared there would land in fuzz-worker's
# process environment even though its code never reads it, which is exactly the
# ambient-secret exposure this fix exists to prevent `fuzz-worker` from ever having.
# `services/model-gateway/gateway/settings.py` reads this directly from the process
# environment; `control-api`/`worker` receive it through their normal `env_file`
# (above, `x-env`), same as every other secret in this file.
MODEL_HOST_BEARER_TOKEN=

# D-123 (.project/decisions.md): the ONE source of truth for both this client's
# request timeout AND model-host-auth's nginx proxy_read_timeout/proxy_send_timeout
# (infrastructure/compose/nginx/model-host-auth/templates/model-host-auth.conf.template,
# rendered by the SAME env var name via that image's own envsubst entrypoint). Before
# this fix the two were two independently hardcoded 300s literals that only matched
# by coincidence -- raising the client's alone did nothing live, because the proxy
# silently re-capped every call at its own value and returned a 504 instead.
#
# Not a secret; declared here (not only apps/control-api/.env.example) because this
# is also what infrastructure/compose/docker-compose*.yml's model-host-auth service
# reads for nginx's envsubst rendering, which only that file's own environment block
# can supply.
#
# 300 (seconds) here is the SAME number as before this fix -- deliberately not
# raised: D-123 found real evidence the real ceiling needs re-measuring after a
# separate, pending memory-capacity decision (Mahatav's call), not re-guessed as
# another round number. Raising it once that is resolved is a one-line change here.
MODEL_HOST_TIMEOUT_SECONDS=300

# --- Sandbox policy ---------------------------------------------------------------
# SANDBOX_NETWORK is deny and there is no other supported value.
SANDBOX_RUNTIME=podman
SANDBOX_NETWORK=deny
SANDBOX_CPU_LIMIT=4
SANDBOX_MEMORY_MB=8192
SANDBOX_MAX_SECONDS=5400

# Pinned fuzzing-toolchain image (#189) — `packages.sandbox.container.ContainerJail`'s
# `ContainerJailPolicy.image` for the FUZZ stage (`workers/fuzzing/run.py::
# run_fuzzing_stage`). Built from infrastructure/compose/images/fuzz-toolchain.Dockerfile,
# EMPTY BY DEFAULT — there is no safe default image for running untrusted target code
# (`ContainerJailPolicy.__post_init__` refuses an empty image), and
# `adapters/cpp/toolchain.py::require_pinned` refuses anything that is not a real
# `name@sha256:<64 hex>` digest, so a floating tag here would fail the same way an unset
# value does, just later and less clearly.
#
# Populate it by actually building and pinning the image, never by hand:
#
#   SANDBOX_FUZZ_IMAGE="$(infrastructure/scripts/build-fuzz-image.sh)"
#
# See that script's header for what "pinned" means for a self-built (not upstream-pulled)
# image, and its documented fallback when the local docker daemon's image store cannot
# resolve a digest without a registry push.
SANDBOX_FUZZ_IMAGE=

# Pinned static-analysis-toolchain image (#22, D-144) — `ContainerJailPolicy.image` for
# the ANALYZE stage (`workers/static_analysis/run.py::run_analyze_stage`, real Semgrep
# scan). Built from infrastructure/compose/images/analyze-toolchain.Dockerfile, EMPTY BY
# DEFAULT for the same reason SANDBOX_FUZZ_IMAGE is -- no safe default image, and
# `adapters/semgrep/errors.py::require_pinned` refuses anything but a real
# `name@sha256:<64 hex>` digest.
#
# Populate it the same way:
#
#   SANDBOX_ANALYZE_IMAGE="$(infrastructure/scripts/build-analyze-image.sh)"
SANDBOX_ANALYZE_IMAGE=

# --- Artifacts ---------------------------------------------------------------------
ARTIFACT_RETENTION_DAYS=14

# --- Finale only ---------------------------------------------------------------------
# The compose edge subnet, so uvicorn trusts X-Forwarded-* from nginx and nothing else.
UVICORN_FORWARDED_ALLOW_IPS=172.31.0.0/24

# --- Dev only ------------------------------------------------------------------------
# SEC-14 (#98). A DIFFERENT variable name from UVICORN_FORWARDED_ALLOW_IPS above,
# deliberately: docker-compose.yml and docker-compose.finale.yml read this same file, and
# `${UVICORN_FORWARDED_ALLOW_IPS:-default}` only falls back to `default` when the variable
# is completely unset — if this were named the same, setting it here for the finale subnet
# would silently apply to the dev stack too. docker-compose.yml already defaults this to
# the pinned `api` network subnet (172.28.90.0/24) when unset; set it explicitly only if
# that subnet ever changes.
UVICORN_DEV_FORWARDED_ALLOW_IPS=172.28.90.0/24
