# Brahmadatta AI ingress — DEVELOPMENT profile.
#
# TEMPLATE, not a static conf file, since D-088 (T0, .project/decisions.md). Rendered to
# /etc/nginx/conf.d/brahmadatta.conf by the nginxinc/nginx-unprivileged image's own
# envsubst entrypoint step (docker-entrypoint.d/20-envsubst-on-templates.sh, ships with the
# image, no extra tooling) — it scans NGINX_ENVSUBST_TEMPLATE_DIR (default
# /etc/nginx/templates, where docker-compose.yml mounts this directory) for `*.template`
# files and writes the substituted result to NGINX_ENVSUBST_OUTPUT_DIR (default
# /etc/nginx/conf.d, which docker-compose.yml adds to this service's `tmpfs` list so the
# write succeeds under `read_only: true`).
#
# ONLY the operator bearer-token variable is interpolated — docker-compose.yml sets
# `NGINX_ENVSUBST_FILTER: '^CONTROL_API_OPERATOR_TOKEN$'` on this service specifically so
# the entrypoint's envsubst call is restricted to that one variable name. Without that
# filter, the entrypoint substitutes EVERY environment variable name it finds textually in
# this file, including as a substring of nginx's own `$variable` syntax below (`$host`,
# `$request_uri`, `$http_upgrade`, `$control_api`, ...) — the filter is what keeps those
# nginx-native variables passed through untouched to the rendered file, for nginx itself to
# resolve at request time, rather than being replaced (usually with an empty string, since
# no container env var shares those names) at render time.
#
# D-094: this comment block deliberately never spells the variable as `$NAME`/`${NAME}` —
# envsubst matches that shell-interpolation syntax anywhere it appears in the file,
# comments included, so writing it out here would get the real secret substituted into a
# comment on render. The bare, dollar-sign-free name above is safe to say; the three
# literal `${...}` references in the `proxy_set_header Authorization` lines below are the
# ONLY substitution sites — do not add another spelled-out reference anywhere in this
# file, including in a comment.
#
# Mounted at /etc/nginx/templates by docker-compose.yml. The finale profile mounts
# templates.finale/ at the same path instead.
#
# Difference from finale, in one line each:
#   - `/` proxies to the Astro DEV SERVER (HMR) instead of serving a static build
#   - CSP is the loosened dev policy
#   - HSTS is not sent (see includes/hsts.conf for why that is deliberate)
#   - /admin/ is allowed from private networks instead of returning 404
#
# Ports are 8080/8443, not 80/443, because the container runs as uid 101 and cannot bind
# a privileged port. docker-compose.yml maps host 8080/8443 straight through.

# DEV ONLY: resolve upstreams at request time, not at startup.
#
# nginx resolves a hostname in an `upstream {}` block once, while parsing the config, and
# refuses to start if it does not resolve. In a dev stack that means one crash-looping
# container takes the whole ingress down with it, and the developer sees "nothing works"
# instead of "the frontend is broken". Assigning the host to a variable defers resolution
# to request time, so a missing service is a 502 on that route and nothing else.
#
# 127.0.0.11 is Docker's embedded DNS, present on every user-defined compose network.
#
# conf.d.finale/ deliberately does NOT do this. In the finale, an unresolvable upstream
# must stop the stack from starting at all — that is a failure you want ten minutes
# before the demo, not during it.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# Contract: the control-api container listens on 8000 and serves
# `config.asgi:application`. See docs/06-operations/71-ingress-and-proxy-contract.md.
map $host $control_api {
    default "control-api:8000";
}

# Contract: `astro dev --host 0.0.0.0 --port 4321`.
map $host $command_center {
    default "command-center:4321";
}

# ---------------------------------------------------------------------------
# Plaintext listener: health probe, then redirect everything to TLS.
# ---------------------------------------------------------------------------
server {
    listen      8080;
    listen      [::]:8080;
    server_name _;

    # Kept on plaintext so the compose healthcheck does not have to trust a self-signed
    # certificate. It reports nginx liveness only — the API's own health lives at
    # /api/v1/system/health and is proxied like any other API call.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "nginx ok\n";
    }

    # $host has no port; the dev TLS listener is on 8443, so it is appended explicitly.
    # The finale profile redirects to https://$host$request_uri with no port.
    location / {
        return 301 https://$host:8443$request_uri;
    }
}

# ---------------------------------------------------------------------------
# TLS listener.
# ---------------------------------------------------------------------------
server {
    listen      8443 ssl;
    listen      [::]:8443 ssl;
    http2       on;
    server_name _;

    include /etc/nginx/includes/tls.conf;

    # Server-level headers. Any location below that calls add_header itself must
    # re-include these two files, or nginx drops the whole inherited set.
    include /etc/nginx/includes/security-headers.conf;
    include /etc/nginx/includes/csp-dev.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "nginx ok\n";
    }

    # -----------------------------------------------------------------------
    # SSE — the mission event stream. MUST be declared before the generic /api/
    # prefix is relied on. It is a regex location, so nginx prefers it over the
    # `/api/` prefix match regardless of file order, but the ordering is kept
    # readable on purpose.
    #
    # Matches GET /api/v1/missions/{id}/events per
    # docs/03-technical/21-api-specification.md.
    #
    # D-088 (T0): the browser EventSource that opens this connection cannot set a custom
    # request header at all, by spec, so the bearer credential has to be attached here,
    # not by the client. proxy_set_header OVERWRITES whatever Authorization header (if
    # any) the client sent, rather than appending to it, so this is the sole source of
    # truth for the header control-api actually receives on this route.
    # -----------------------------------------------------------------------
    location ~ ^/api/v1/missions/[^/]+/events/?$ {
        # sse.conf, NOT proxy-common.conf. It pulls in the shared headers itself and adds
        # proxy_buffering off plus the stream timeouts. Read the comment block in it.
        include /etc/nginx/includes/sse.conf;

        include /etc/nginx/includes/security-headers.conf;
        include /etc/nginx/includes/csp-dev.conf;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://$control_api$request_uri;
    }

    # Django admin: allowed from private networks in dev, 404 in finale.
    # docker-compose*.yml decides which file lands at this path.
    #
    # D-088 (T0): deliberately NOT one of the three locations that gets the injected
    # Authorization header. Django admin authenticates with its own session/cookie login,
    # not BearerTokenAuth (api/auth.py) — this proxy credential is meaningless to it.
    include /etc/nginx/profile/admin.conf;

    # SEC-04 (#95): mirrors conf.d.finale/brahmadatta.conf — see the comment there. Sized
    # to SNAPSHOT_MAX_BYTES in apps/control-api/config/settings/base.py.
    #
    # D-088 (T0): one of the three control-api-proxied locations that gets the injected
    # bearer credential — see the header comment block above for the envsubst mechanics.
    location ~ ^/api/v1/missions/[^/]+/snapshot/?$ {
        include /etc/nginx/includes/proxy-common.conf;
        client_max_body_size 512m;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://$control_api$request_uri;
    }

    # D-088 (T0): the third and last control-api-proxied location that gets the injected
    # bearer credential. Every mission/evidence endpoint requires `BearerTokenAuth`
    # (apps/control-api/api/auth.py); before this, nothing in the browser, Astro, or nginx
    # ever supplied one, so every proxied call 401'd. nginx now supplies it on every
    # request through this location, regardless of what (if anything) the browser sent —
    # the browser never needs to hold or attach a credential at all.
    location /api/ {
        include /etc/nginx/includes/proxy-common.conf;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://$control_api$request_uri;
    }

    # No location here for Django-collected static: STATIC_URL = "/django-static/"
    # (config/settings/base.py), not "/static/" — a plain `location /static/` block never
    # matches real traffic, since nginx prefix matching requires the URI to literally start
    # with "/static/". The one real consumer, admin CSS, is already served behind
    # profile/admin-allow.conf's `^~ /django-static/` location. See #133.

    # Everything else is the Astro dev server, including the HMR WebSocket. The Upgrade
    # and Connection headers come from proxy-headers.conf and need no override here.
    #
    # D-088 (T0): deliberately NOT given the Authorization header. This proxies to the
    # Astro dev server, not control-api — the static/dev-server asset path has no reason
    # to see the operator credential, and the ruling is explicit that injection is scoped
    # to the control-api-proxied locations only.
    location / {
        include /etc/nginx/includes/proxy-headers.conf;

        # Vite's HMR socket is long-lived and mostly idle — same reasoning as sse.conf,
        # different stream.
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering    off;

        proxy_pass http://$command_center$request_uri;
    }
}
