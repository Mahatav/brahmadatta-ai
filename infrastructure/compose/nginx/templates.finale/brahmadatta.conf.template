# Brahmadatta AI ingress — FINALE profile.
#
# TEMPLATE, not a static conf file, since D-088 (T0, .project/decisions.md). Rendered to
# /etc/nginx/conf.d/brahmadatta.conf by the nginxinc/nginx-unprivileged image's own
# envsubst entrypoint step (docker-entrypoint.d/20-envsubst-on-templates.sh, ships with the
# image, no extra tooling) — it scans NGINX_ENVSUBST_TEMPLATE_DIR (default
# /etc/nginx/templates, where docker-compose.finale.yml mounts this directory) for
# `*.template` files and writes the substituted result to NGINX_ENVSUBST_OUTPUT_DIR
# (default /etc/nginx/conf.d, which docker-compose.finale.yml adds to this service's
# `tmpfs` list so the write succeeds under `read_only: true`).
#
# ONLY the operator bearer-token variable is interpolated — docker-compose.finale.yml sets
# `NGINX_ENVSUBST_FILTER: '^CONTROL_API_OPERATOR_TOKEN$'` on this service specifically so
# the entrypoint's envsubst call is restricted to that one variable name. Without that
# filter, the entrypoint substitutes EVERY environment variable name it finds textually in
# this file, including as a substring of nginx's own `$variable` syntax below (`$host`,
# `$request_uri`, `$http_upgrade`, ...) — the filter is what keeps those nginx-native
# variables passed through untouched to the rendered file, for nginx itself to resolve at
# request time, rather than being replaced (usually with an empty string, since no
# container env var shares those names) at render time.
#
# D-094: this comment block deliberately never spells the variable as `$NAME`/`${NAME}` —
# envsubst matches that shell-interpolation syntax anywhere it appears in the file,
# comments included, so writing it out here would get the real secret substituted into a
# comment on render. The bare, dollar-sign-free name above is safe to say; the three
# literal `${...}` references in the `proxy_set_header Authorization` lines below are the
# ONLY substitution sites — do not add another spelled-out reference anywhere in this
# file, including in a comment.
#
# Mounted at /etc/nginx/templates by docker-compose.finale.yml.
#
# Difference from dev, in one line each:
#   - `/` serves the built Astro output from disk; there is no dev server in this profile
#   - the stage origin is http://localhost:8080, with no browser TLS warning
#   - CSP has no 'unsafe-inline' / 'unsafe-eval' / ws:
#   - HSTS is not sent; HSTS on localhost would poison later plain HTTP runs
#   - /admin returns 404 (profile/admin-deny.conf is mounted at /etc/nginx/profile/admin.conf)

upstream control_api {
    server control-api:8000 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen      8080;
    listen      [::]:8080;
    server_name _;

    include /etc/nginx/includes/security-headers.conf;
    include /etc/nginx/includes/csp-finale.conf;

    root  /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "nginx ok\n";
    }

    # -----------------------------------------------------------------------
    # SSE. See includes/sse.conf — proxy_buffering off is the whole point.
    #
    # D-088 (T0): the browser EventSource that opens this connection cannot set a custom
    # request header at all, by spec, so the bearer credential has to be attached here,
    # not by the client. proxy_set_header OVERWRITES whatever Authorization header (if
    # any) the client sent, rather than appending to it, so this is the sole source of
    # truth for the header control-api actually receives on this route.
    # -----------------------------------------------------------------------
    location ~ ^/api/v1/missions/[^/]+/events/?$ {
        # sse.conf, NOT proxy-common.conf. Read the comment block in it.
        include /etc/nginx/includes/sse.conf;

        include /etc/nginx/includes/security-headers.conf;
        include /etc/nginx/includes/csp-finale.conf;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://control_api;
    }

    # Resolves to profile/admin-deny.conf in this profile — see the mount in
    # docker-compose.finale.yml. Returns 404, not 403.
    #
    # D-088 (T0): deliberately NOT one of the three locations that gets the injected
    # Authorization header. Django admin authenticates with its own session/cookie login,
    # not BearerTokenAuth (api/auth.py) — this proxy credential is meaningless to it, and
    # the finale profile closes this route to a 404 anyway.
    include /etc/nginx/profile/admin.conf;

    # SEC-05 (#96): belt and braces with API_DOCS_ENABLED=False in config/settings/finale.py
    # — the application closes these, and so does the proxy, so neither one being wrong
    # alone is sufficient. Declared above location /api/ for the same reason the SSE and
    # snapshot-upload locations are: an exact (`=`) and a prefix (`^~`) match both win over
    # a plain-prefix location regardless of file order, but the ordering stays readable.
    location = /api/v1/openapi.json { return 404; }
    location ^~ /api/v1/docs        { return 404; }

    # SEC-04 (#95): the only location that legitimately carries more than the http-level
    # `client_max_body_size 64m;`. Sized to SNAPSHOT_MAX_BYTES in
    # apps/control-api/config/settings/base.py — the repository-snapshot DoS ceiling, not
    # a realistic size. Must be declared before the /api/ prefix location, same as the SSE
    # location above: a regex location wins over a plain-prefix one regardless of order,
    # but the ordering is kept readable on purpose.
    #
    # D-088 (T0): one of the three control-api-proxied locations that gets the injected
    # bearer credential — see the header comment block above for the envsubst mechanics.
    location ~ ^/api/v1/missions/[^/]+/snapshot/?$ {
        include /etc/nginx/includes/proxy-common.conf;
        client_max_body_size 512m;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://control_api;
    }

    # D-088 (T0): the third and last control-api-proxied location that gets the injected
    # bearer credential. Every mission/evidence endpoint requires `BearerTokenAuth`
    # (apps/control-api/api/auth.py); before this, nothing in the browser, Astro, or nginx
    # ever supplied one, so every proxied call 401'd. nginx now supplies it on every
    # request through this location, regardless of what (if anything) the browser sent —
    # the browser never needs to hold or attach a credential at all.
    location /api/ {
        include /etc/nginx/includes/proxy-common.conf;

        proxy_set_header Authorization "Bearer ${CONTROL_API_OPERATOR_TOKEN}";

        proxy_pass http://control_api;
    }

    # -----------------------------------------------------------------------
    # Static: the Astro build output.
    #
    # Astro emits content-hashed assets under /_astro/. Those are safe to cache
    # forever. Everything else is not: a stale HTML shell pointing at an asset
    # bundle that no longer exists is exactly the failure that ruins a live
    # demo after a mid-finale redeploy.
    #
    # D-088 (T0): deliberately NOT given the Authorization header, same as every other
    # location in this block below. Static files have no reason to see the operator
    # credential, and the ruling is explicit that injection is scoped to the three
    # control-api-proxied locations above only.
    # -----------------------------------------------------------------------
    location ^~ /_astro/ {
        include /etc/nginx/includes/security-headers.conf;
        include /etc/nginx/includes/csp-finale.conf;

        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        gzip            on;
        gzip_vary       on;
        gzip_min_length 1024;
        gzip_types      text/css application/javascript application/json image/svg+xml application/wasm;

        access_log off;
        try_files $uri =404;
    }

    # Unhashed static assets (favicon, fonts, hand-authored SVG engravings). Hashed
    # names are not guaranteed here, so cache for an hour and revalidate.
    location ~* \.(?:ico|png|jpg|jpeg|gif|webp|avif|svg|woff2?|ttf|otf|eot)$ {
        include /etc/nginx/includes/security-headers.conf;
        include /etc/nginx/includes/csp-finale.conf;

        add_header Cache-Control "public, max-age=3600" always;

        gzip            on;
        gzip_vary       on;
        gzip_min_length 1024;
        gzip_types      image/svg+xml font/ttf font/otf;

        access_log off;
        try_files $uri =404;
    }

    # No location here for Django-collected static: STATIC_URL = "/django-static/"
    # (config/settings/base.py), not "/static/" — a plain `location /static/` block never
    # matches real traffic, since nginx prefix matching requires the URI to literally start
    # with "/static/". Nothing in the finale profile references it either way: the admin app
    # is removed from INSTALLED_APPS (finale.py) and the docs page is off (SEC-05), the only
    # two features that ever pulled from STATIC_URL. If a future feature needs it, add a
    # guarded `location ^~ /django-static/` deliberately rather than reviving this one — see
    # #133 and the django-static volume still mounted in docker-compose.finale.yml.

    # HTML shell and everything else. Astro's static output puts routes at
    # /route/index.html, hence the $uri/index.html step.
    location / {
        include /etc/nginx/includes/security-headers.conf;
        include /etc/nginx/includes/csp-finale.conf;

        add_header Cache-Control "no-cache, must-revalidate" always;

        gzip            on;
        gzip_vary       on;
        gzip_min_length 1024;
        # text/html is always gzipped by nginx and must not be listed again — it warns.
        gzip_types      text/css application/javascript application/json image/svg+xml;

        try_files $uri $uri/index.html $uri.html /404.html;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
